  "deload_weeks": [5, 10],
  "test_week": true,
  "travel": false,
  "modules": ["correctives"],
  "successors": ["knight", "olympian", "soldier"],
  "sources": ["Schoenfeld et al. (2017)", "Helms et al. (2016)"],
