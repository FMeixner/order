  "id": "gladiator",
  "name": "Gladiator", "name_w": "Gladiatrix",
  "tagline": "Die Grube vergisst keine Zeit.",
  "description": "Kondition als Sport vor Zeugen, nicht als Hintergrundlärm: vier Events die Woche. „Lasten“ hebt die Sandsack-Familie — Ground-to-Shoulder, Squat, Bent-Over Row — und trägt; das Gewicht lebt, der Rumpf lernt das Segeln. „Runde“ mischt Seilsprints und Burpee-Intervalle im A/B-Wechsel mit Swing-Supersets, „Eisen“ hält die Kraftachse mit Langhantel und Rudern, „Spiel“ misst Shuttle, Sprints und Sprünge. Die Bestie sitzt als Finisher hinter den Lasten — dieselbe Klasse wie der Tag: kurz und hämisch. Wer keinen Sandsack hat, bekommt automatisch Kurzhantel- und Band-Varianten angezeigt; draußen läuft die Woche mit Widerstandsbändern. In der Testwoche zeigt die Grube, was messbar geworden ist.",
  "goals": { "primary": "conditioning", "secondary": ["strength", "endurance"] },
  "nutrition": "maintenance",
  "load_fit": "medium",
  "level": "intermediate",
  "session_min": 45,
  "weeks": { "min": 8, "max": 10 },
  "test_week": true,
  "travel": true,
  "modules": ["correctives", "beast"],
  "successors": ["knight", "smith", "pilgrim", "troubadour"],
  "sources": ["Cooper (1968)", "Helgerud et al. (2007)", "Kaminsky et al. (2022)", "Kotarsky et al. (2018)"],
  "week_4": ["lasten", "runde", "eisen", "spiel"],
  "week_3": ["lasten", "runde", "eisen"],
