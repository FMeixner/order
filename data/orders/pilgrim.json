{
  "schema": 1,
  "id": "pilgrim",
  "name": "Pilgrim",
  "tagline": "Herz-Kreislauf zuerst, Kraft bleibt.",
  "description": "Einmal hohe Intensität (4 × 4 Min), einmal lange Grundlage im Sprechtempo, eine lange Bestie und eine kurze Kraft-Erhaltung. Herz-Kreislauf-Fitness ist einer der stärksten Einzelmarker für Langlebigkeit. Die Kraft-Erhaltung läuft mit Körpergewicht, ohne Aufbau und an jedem Ort gleich.",
  "goals": {"primary": "endurance", "secondary": ["conditioning", "strength"]},
  "nutrition": "any",
  "load_fit": "medium",
  "level": "beginner–intermediate",
  "session_min": 45,
  "weeks": {"min": 8, "max": 12},
  "test_week": true,
  "travel": true,
  "modules": ["correctives", "beast"],
  "successors": ["troubadour", "olympian", "knight"],
  "sources": ["Helgerud et al. (2007)", "Mandsager et al. (2018)", "Kotarsky et al. (2018)", "Kikuchi & Nakazato (2017)", "Refalo et al. (2023)"],
  "week_4": ["intervalle", "kraft_kurz", "bestie_lang", "grundlage"],
  "week_3": ["intervalle", "kraft_kurz", "grundlage"],
  "roles": {
    "intervalle": {
      "name": "Intervalle", "location": "reise", "minutes": 45,
      "warmup": ["run_prep"], "cooldown": ["cd_lower"],
      "blocks": [
        {"type": "single", "slot": {"id": "rh-i-1", "name": "Intervalle 4 × 4 Min", "kind": "interval", "interval": {"work": 240, "rest": 180, "rounds": 4}, "prog": "none", "note": "85–95 % der maximalen Herzfrequenz. Lauf, Rad oder Rudern."}},
        {"type": "superset", "rest": 60, "slots": [
          {"id": "rh-i-2a", "name": "Bodyweight Squat", "sets": 2, "reps": "15-30", "prog": "ladder", "ladder": ["Bodyweight Squat", "Squat Jump"]},
          {"id": "rh-i-2b", "name": "Push-Up", "sets": 2, "reps": "10-25", "prog": "ladder", "ladder": ["Push-Up", "Deficit Push-Up", "Archer Push-Up"]}
        ]}
      ]
    },
    "kraft_kurz": {
      "name": "Kraft-Erhaltung", "location": "home", "minutes": 45,
      "warmup": ["base"], "cooldown": ["cd_general"],
      "blocks": [
        {"type": "single", "slot": {"id": "rh-k-1", "name": "Single-Leg RDL", "sets": 3, "reps": "10-15/Seite", "prog": "reps", "rest": 60}},
        {"type": "single", "slot": {"id": "rh-k-2", "name": "Table Row", "sets": 3, "reps": "10-20", "prog": "ladder", "ladder": ["Table Row", "Ring Row", "Ring Row (Füße erhöht)"], "rest": 75}},
        {"type": "single", "slot": {"id": "rh-k-3", "name": "Pistol Squat (Box)", "sets": 3, "reps": "6-15/Seite", "prog": "ladder", "ladder": ["Pistol Squat (Box)", "Pistol Squat (Gegengewicht)", "Pistol Squat"], "rest": 75}},
        {"type": "single", "slot": {"id": "rh-k-4", "name": "Farmer's Carry", "reise": "Suitcase Carry", "sets": 3, "reps": "40 m", "prog": "weight", "rest": 60}},
        {"type": "single", "slot": {"id": "rh-k-5", "name": "Lockeres Ausfahren", "kind": "timer", "minutes": 15, "prog": "none"}}
      ]
    },
    "bestie_lang": {
      "name": "Lange Bestie", "location": "home", "minutes": 40,
      "warmup": ["base", "jump_prep"], "cooldown": ["cd_calm"],
      "blocks": [
        {"type": "beast", "id": "rh-b-1", "classes": ["uralte"], "draw": "rotate"}
      ]
    },
    "grundlage": {
      "name": "Grundlage", "location": "reise", "minutes": 60,
      "warmup": ["run_prep"], "cooldown": ["cd_lower"],
      "blocks": [
        {"type": "single", "slot": {"id": "rh-g-1", "name": "Lockere Grundlage", "kind": "timer", "minutes": 45, "max": 75, "step": 5, "prog": "minutes", "note": "Sprechtempo. Lauf, Rad, Rudern oder Wandern."}}
      ]
    },
    "bonus": {
      "name": "Bonus: Füße und Schienbein", "location": "home", "minutes": 45,
      "note": "Nur bei fünf Tagen. Läuferfüße, dazu eine lange ruhige Bestie.",
      "warmup": ["short_base"], "cooldown": ["cd_general"],
      "blocks": [
        {"type": "single", "slot": {"id": "bx-pi-c", "name": "Single-Leg Calf Raise", "sets": 3, "reps": "12-20/Seite", "prog": "reps", "rest": 45}},
        {"type": "single", "slot": {"id": "bx-pi-t", "name": "Tibialis Raise", "sets": 3, "reps": "15-25", "prog": "reps", "rest": 45}},
        {"type": "single", "slot": {"id": "bx-pi-b", "name": "Einbeinstand, Augen zu", "kind": "hold", "hold": 30, "sets": 2, "prog": "hold", "rest": 30, "max": 60, "step": 5, "note": "pro Seite"}},
        {"type": "beast", "id": "bx-pi-bst", "classes": ["ungeheuer"], "draw": "rotate", "pace": "easy"}
      ]
    }
  }
}
