{
  "schema": 1,
  "id": "barbarian",
  "name": "Barbarian", "name_w": "Barbarian",
  "tagline": "Masse ohne Studio.",
  "description": "Muskelaufbau mit Kurzhanteln, Bändern, Stange und eigenem Körper — zu Hause, im Hotel, unterwegs. Oberkörper und Unterkörper im Wechsel, jeder Muskel zweimal pro Woche, etwa 10–14 harte Sätze je Muskel. Übungen mit tiefer Dehnung (Deficit Push-Ups, Bulgarian Split Squats, RDL, Überkopf-Trizeps), nah ans Muskelversagen, weil die Lasten leichter sind als im Studio. Jeder Tag beginnt mit einer Isolationsübung für den Muskel, den die erste Grundübung trifft.",
  "goals": {"primary": "hypertrophy", "secondary": ["strength"]},
  "nutrition": "surplus",
  "load_fit": "high",
  "level": "beginner–intermediate",
  "session_min": 50,
  "weeks": {"min": 8, "max": 12},
  "test_week": true,
  "travel": true,
  "modules": ["correctives", "beast"],
  "successors": ["knight", "slayer", "mercenary", "troubadour"],
  "sources": ["Schoenfeld, Ogborn & Krieger (2016)"],
  "week_4": ["oben_a", "unten_a", "oben_b", "unten_b"],
  "week_3": ["oben_a", "unten_a", "oben_b"],
