{
  "schema": 1,
  "id": "pugilist",
  "name": "Pugilist",
  "tagline": "Rumpf, Nacken, Runden.",
  "description": "Kampfsportnahes Training: Rumpf, Nacken, Rotationskraft und Kondition in Runden (Arbeit und Pause wie im Ring). Das Kampfmodul ist Schattenboxen, mit Schwert im Equipment-Profil das Schwert. Kraft überwiegend mit Körpergewicht in Stufen, dazu Rotation am Kabel oder mit Kettlebell.",
  "goals": {"primary": "skill", "secondary": ["conditioning", "strength"]},
  "nutrition": "maintenance",
  "load_fit": "high",
  "level": "beginner–intermediate",
  "session_min": 45,
  "weeks": {"min": 8, "max": 10},
  "test_week": true,
  "travel": true,
  "modules": ["correctives", "beast", "sword"],
  "sources": ["Kotarsky et al. (2018)", "Kikuchi & Nakazato (2017)", "Refalo et al. (2023)"],
  "successors": ["huntsman", "king", "olympian", "gladiator"],
  "week_4": ["runden_technik", "kraft_rotation", "runden_kondition", "nacken_rumpf"],
  "week_3": ["runden_technik", "kraft_rotation", "runden_kondition"],
  "roles": {
    "runden_technik": {
      "name": "Technikrunden", "location": "reise", "minutes": 40,
      "warmup": ["base"], "cooldown": ["cd_general"],
      "blocks": [
        {"type": "module", "module": "sword", "variant": "einzelmesser", "fallback": {"id": "fi-t-1", "name": "Schattenboxen: Technikrunden", "kind": "interval", "interval": {"work": 180, "rest": 60, "rounds": 4}, "prog": "none"}},
        {"type": "single", "slot": {"id": "fi-t-2", "name": "Beinarbeit-Drill (Linien)", "kind": "interval", "interval": {"work": 60, "rest": 30, "rounds": 3}, "prog": "none"}},
        {"type": "superset", "rest": 45, "slots": [
          {"id": "fi-t-3a", "name": "Neck Curl", "sets": 2, "reps": "15", "prog": "reps"},
          {"id": "fi-t-3b", "name": "Neck Extension", "sets": 2, "reps": "15", "prog": "reps"}
        ]},
        {"type": "single", "slot": {"name": "Neck Curl Complex (leichte KB)", "sets": 2, "reps": "20", "prog": "none", "rest": 45, "note": "Je Satz 5 vorwärts, 5 links, 5 rückwärts, 5 rechts. Langsam, voller Bewegungsumfang, kein Ruck.", "id": "pug-runden-neck"}}
      ]
    },
    "kraft_rotation": {
      "name": "Kraft und Rotation", "location": "home", "minutes": 55,
      "warmup": ["short_base", "shoulder_prep", "lower_prep"], "cooldown": ["cd_general"],
      "blocks": [
        {"type": "single", "slot": {"id": "fi-r-1", "core": true, "name": "Medicine Ball Rotational Throw", "reise": {"name": "Band Woodchopper", "reps": "10/Seite", "prog": "reps"}, "sets": 4, "reps": "5/Seite", "prog": "none", "rest": 60}},
        {"type": "single", "slot": {"id": "fi-r-2", "name": "Cable Woodchopper", "home": "KB Woodchop", "reise": {"name": "Band Woodchopper", "prog": "reps"}, "sets": 3, "reps": "10/Seite", "prog": "double", "rest": 60}},
        {"type": "superset", "rest": 60, "slots": [
          {"id": "fi-r-3a", "core": true, "name": "Cossack Squat", "sets": 4, "reps": "8-15/Seite", "prog": "reps"},
          {"id": "fi-r-3b", "name": "Push-Up", "sets": 4, "reps": "10-25", "prog": "ladder", "ladder": ["Push-Up", "Deficit Push-Up", "Archer Push-Up"]}
        ]},
        {"type": "superset", "rest": 75, "slots": [
          {"id": "fi-r-4", "core": true, "name": "Table Row", "sets": 4, "reps": "10-20", "prog": "ladder", "ladder": ["Table Row", "Ring Row", "Ring Row (Füße erhöht)"]},
          {"id": "fi-r-5", "name": "Single-Leg RDL", "sets": 4, "reps": "8-12/Seite", "prog": "reps", "note": "Erhaltung: schwer genug, 2 Wiederholungen Reserve. Hält Kraft und Muskel, auch wenn der Orden anderes betont."}
        ]}
      ]
    },
    "runden_kondition": {
      "name": "Konditionsrunden", "location": "home", "minutes": 40,
      "warmup": ["short_base", "jump_prep", "full_prep"], "cooldown": ["cd_calm"],
      "blocks": [
        {"type": "module", "module": "call", "variant": "schatten"},
        {"type": "beast", "id": "fi-k-2", "classes": ["plage", "bestie"]}
      ]
    },
    "nacken_rumpf": {
      "name": "Nacken und Rumpf", "location": "home", "minutes": 35,
      "warmup": ["base"], "cooldown": ["cd_general"],
      "blocks": [
        {"type": "single", "slot": {"id": "fi-n-1", "name": "Nackenisometrie, 4 Richtungen", "kind": "hold", "hold": 20, "max": 40, "step": 5, "sets": 4, "prog": "hold", "rest": 20, "note": "Hand gegen den Kopf, je Richtung ein Satz."}},
        {"type": "superset", "rest": 45, "slots": [
          {"id": "fi-n-2a", "name": "Dead Bug", "sets": 3, "reps": "8/Seite", "prog": "reps"},
          {"id": "fi-n-2b", "name": "Band Pallof Press", "sets": 3, "reps": "12/Seite", "prog": "reps"}
        ]},
        {"type": "single", "slot": {"id": "fi-n-3", "core": true, "name": "Turkish Get-Up", "reise": {"name": "Turkish Get-Up (ohne Last)", "prog": "reps"}, "sets": 3, "reps": "2/Seite", "prog": "weight", "rest": 60}},
        {"type": "single", "slot": {"id": "fi-n-4", "core": true, "name": "Farmer's Carry", "reise": "Suitcase Carry", "sets": 3, "reps": "40 m", "prog": "weight", "rest": 60}},
        {"type": "single", "slot": {"id": "fi-n-5", "name": "Side Plank", "kind": "hold", "hold": 30, "max": 60, "step": 5, "sets": 2, "prog": "hold", "rest": 30, "note": "pro Seite"}}
      ]
    },
    "bonus": {
      "name": "Bonus: Seil und Unterarme", "location": "home", "minutes": 45,
      "warmup": ["short_base", "full_prep"], "cooldown": ["cd_general"],
      "blocks": [
        {"type": "single", "slot": {"id": "bx-pu-r", "name": "Seilspringen", "kind": "interval", "interval": {"work": 40, "rest": 20, "rounds": 8}, "prog": "none"}},
        {"type": "superset", "rest": 60, "slots": [
          {"id": "bx-pu-fa", "name": "Wrist Curl", "sets": 3, "reps": "12-20", "prog": "double"},
          {"id": "bx-pu-fb", "name": "Reverse Wrist Curl", "sets": 3, "reps": "12-20", "prog": "double"}
        ]},
        {"type": "beast", "id": "bx-pu-bst", "classes": ["plage"]},
        {"type": "beast", "id": "bx-pu-bst2", "classes": ["plage"]}
      ]
    }
  }
}
