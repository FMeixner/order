{
  "schema": 1,
  "id": "king",
  "name": "King",
  "tagline": "Harte Tage, bewusste Erholung.",
  "description": "Intensive Tage im Wechsel mit Meditation und Yoga. Nach jedem harten Tag fragt die App, wie es sich angefühlt hat (Feeling Scale −5 bis +5). Zweimal hintereinander −1 oder schlechter: Die nächste harte Einheit wird leichter.",
  "goals": {"primary": "conditioning", "secondary": ["wellbeing"]},
  "nutrition": "any",
  "load_fit": "medium",
  "level": "intermediate",
  "session_min": 40,
  "weeks": {"min": 8, "max": 12},
  "test_week": true,
  "affect_rule": true,
  "travel": true,
  "modules": ["correctives", "beast"],
  "successors": ["troubadour", "pilgrim", "monk"],
  "sources": ["Ekkekakis et al. (2011)", "Hardy & Rejeski (1989)"],
  "week_4": ["hart_a", "erholung", "hart_b", "hart_c"],
  "week_3": ["hart_a", "erholung", "hart_b"],
  "roles": {
    "hart_a": {
      "name": "Hart A", "location": "home", "minutes": 40,
      "warmup": ["base", "jump_prep"], "cooldown": ["cd_calm"],
      "blocks": [
        {"type": "beast", "id": "ki-a-1", "classes": ["ungeheuer"], "draw": "rotate"},
        {"type": "single", "slot": {"id": "ki-a-2", "name": "Lockeres Auslaufen", "kind": "timer", "minutes": 10, "prog": "none"}}
      ]
    },
    "erholung": {
      "name": "Erholung", "location": "reise", "minutes": 35,
      "warmup": [], "cooldown": [],
      "blocks": [
        {"type": "single", "slot": {"id": "ki-e-1", "name": "Meditation, offenes Gewahrsein", "kind": "timer", "minutes": 15, "max": 20, "step": 1, "prog": "minutes"}},
        {"type": "single", "slot": {"id": "ki-e-2", "name": "Yoga Slow Flow", "kind": "timer", "minutes": 20, "prog": "none"}}
      ]
    },
    "hart_b": {
      "name": "Hart B", "location": "reise", "minutes": 35,
      "warmup": ["run_prep", "jump_prep"], "cooldown": ["cd_calm"],
      "blocks": [
        {"type": "single", "slot": {"id": "ki-b-1", "name": "Sprint oder Seilspringen 10 × 30 s", "kind": "interval", "interval": {"work": 30, "rest": 60, "rounds": 10}, "prog": "none"}},
        {"type": "superset", "label": "Superset", "rest": 60, "slots": [
          {"id": "ki-b-2a", "name": "KB Swing", "reise": {"name": "Band Pull-Through", "prog": "reps"}, "sets": 3, "reps": "15", "prog": "weight"},
          {"id": "ki-b-2b", "name": "Push-Up", "sets": 3, "reps": "8-15", "prog": "ladder", "ladder": ["Incline Push-Up", "Push-Up", "Deficit Push-Up"]}
        ]}
      ]
    },
    "hart_c": {
      "name": "Hart C", "location": "home", "minutes": 30, "optional": true,
      "warmup": ["base"], "cooldown": ["cd_calm"],
      "blocks": [
        {"type": "beast", "id": "ki-c-1", "classes": ["bestie"], "draw": "rotate"}
      ]
    }
  }
}
